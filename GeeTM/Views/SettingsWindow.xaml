<Window x:Class="GeeTM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:GeeTM.Services"
        Title="GeeTM Settings"
        Height="660" Width="880" MinHeight="480" MinWidth="720"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootShell" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Height="46">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="GeeTM" FontFamily="{DynamicResource UiFont}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontFamily="{DynamicResource UiFont}" FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Content="&#x2715;" Style="{DynamicResource CloseCaptionButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Close without saving"/>
            </Grid>

            <!-- SUCCESS BANNER -->
            <Border x:Name="SaveSuccessBanner" Grid.Row="1" Background="#10B981" Padding="12" Visibility="Collapsed" 
                    VerticalAlignment="Top" Margin="20,10" CornerRadius="8" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#x2713;" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings saved successfully!" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- BODY -->
            <TabControl Grid.Row="2" Margin="20,4,20,0">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="ScrollCachePanel1" Margin="0,0,14,10" CacheMode="BitmapCache">
                            <TextBlock Text="Look" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="The overall visual style, kept separate from the colour theme below - mix and match either look with any of the four colour themes." Style="{DynamicResource Body}" Margin="0,0,0,14"/>
                            <RadioButton x:Name="LookClassic" GroupName="Look" Content="Classic - the current look" Checked="LookOption_Checked" Margin="0,0,0,12"/>
                            <RadioButton x:Name="LookPremium" GroupName="Look" Content="Premium - softer glows, layered depth, refined accents" Checked="LookOption_Checked"/>
                            <Border Style="{DynamicResource Divider}"/>

                            <TextBlock Text="Appearance theme" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="Applies to every GeeTM window, and previews live as you browse." Style="{DynamicResource Body}" Margin="0,0,0,12"/>
                            <ComboBox x:Name="SkinCombo" Width="240" HorizontalAlignment="Left" SelectionChanged="SkinCombo_SelectionChanged"/>
                            <Border Style="{DynamicResource Divider}"/>

                            <TextBlock Text="Display mode" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Style="{DynamicResource Body}" Margin="0,0,0,12" Text="Experimental, off by default. The floating widget (this setting off) is the supported, recommended mode."/>
                            <CheckBox x:Name="EmbedCheck" Style="{DynamicResource SwitchToggle}" Content="Embed the widget inside the taskbar"/>
                            <TextBlock x:Name="EmbedHint" Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                            <Border Style="{DynamicResource Divider}"/>

                            <TextBlock Text="Behaviour" Style="{DynamicResource H2}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="StartupCheck" Style="{DynamicResource SwitchToggle}" Content="Launch GeeTM when Windows starts" Margin="0,0,0,12"/>
                            <CheckBox x:Name="FullscreenHideCheck" Style="{DynamicResource SwitchToggle}" Content="Hide the widget while something is running fullscreen" Margin="0,0,0,12"/>
                            <CheckBox x:Name="FullscreenOverlayCheck" Style="{DynamicResource SwitchToggle}" Content="Show a small overlay instead of hiding completely"/>
                            <TextBlock Text="A compact, click-through speed readout in the corner of the screen - useful while gaming or streaming, where the taskbar isn't visible anyway." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18"/>
                            <CheckBox x:Name="ClickThroughCheck" Style="{DynamicResource SwitchToggle}" Content="Let clicks pass through the widget" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ProcessBreakdownCheck" Style="{DynamicResource SwitchToggle}" Content="Track bandwidth per process (needs administrator)"/>
                            <TextBlock x:Name="AdminHint" Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18"/>
                            <CheckBox x:Name="VpnNotificationsCheck" Style="{DynamicResource SwitchToggle}" Content="Notify when a VPN connects or disconnects"/>
                            <TextBlock Text="Detects known VPN adapters appearing or disappearing - a best-effort signal, not a guarantee, since not every VPN setup is detectable this way." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18"/>
                            <CheckBox x:Name="ThreatCheckEnabledCheck" Style="{DynamicResource SwitchToggle}" Content="Show an IP threat score in the rotating pill"/>
                            <TextBlock Text="Requires your own free AbuseIPDB API key - sign up at abuseipdb.com to get one. GeeTM sends your current public IP to AbuseIPDB to check it; nothing else is shared." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,10"/>
                            <TextBox x:Name="AbuseIpDbKeyBox" Width="320" HorizontalAlignment="Left"/>
                            <Border Style="{DynamicResource Divider}"/>

                            <TextBlock Text="Performance" Style="{DynamicResource H2}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Update interval" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider x:Name="PollSlider" Grid.Column="1" Minimum="250" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock x:Name="PollValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="How often the adapter counters are sampled." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scroll speed" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider x:Name="ScrollSpeedSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Margin="0,6"/>
                                <TextBlock x:Name="ScrollSpeedValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Controls how far one mouse-wheel notch travels." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="ScrollCachePanel2" Margin="0,0,14,10" CacheMode="BitmapCache">
                            <TextBlock Text="Widget background" Style="{DynamicResource H2}" Margin="0,0,0,10"/>
                            <RadioButton x:Name="ColorAuto" GroupName="ColorMode" Content="Match my taskbar, a shade darker" Margin="0,0,0,10"/>
                            <RadioButton x:Name="ColorAutoExact" GroupName="ColorMode" Content="Match my taskbar exactly" Margin="0,0,0,10"/>
                            <RadioButton x:Name="ColorCustom" GroupName="ColorMode" Content="Use a custom colour"/>
                            <Grid Margin="0,16,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DARKEN AMOUNT" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <Slider x:Name="DarkenSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,6"/>
                                <TextBlock x:Name="DarkenValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="CUSTOM COLOUR" Style="{DynamicResource Eyebrow}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="BgPresetCombo" Width="210" SelectionChanged="BgPresetCombo_SelectionChanged"/>
                                <TextBox x:Name="BgHexBox" Width="110" Margin="10,0,0,0" TextChanged="BgHexBox_TextChanged"/>
                                <Border x:Name="ColorPreview" Width="34" Height="34" CornerRadius="8" Margin="10,0,0,0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                            </StackPanel>
                            <Grid Margin="0,16,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BACKGROUND OPACITY" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,6"/>
                                <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Ignored in embedded mode." Style="{DynamicResource Body}" Margin="0,6,0,0"/>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Shape" Style="{DynamicResource H2}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CORNER RADIUS" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <Slider x:Name="CornerRadiusSlider" Grid.Column="1" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock x:Name="CornerRadiusValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <CheckBox x:Name="ShadowCheck" Style="{DynamicResource SwitchToggle}" Margin="0,10,0,0" Content="Drop shadow behind the widget (floating mode only)"/>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Pill shape" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="How the two pills sit next to each other - kept separate, or joined into what reads as one shape divided by the gap between them." Style="{DynamicResource Body}" Margin="0,0,0,16"/>
                            <RadioButton x:Name="ShapeTwoPods" GroupName="PillShape" Content="Two separate pods - fully rounded, independent" Margin="0,0,0,12"/>
                            <RadioButton x:Name="ShapeOnePod" GroupName="PillShape" Content="One pod, divided by the gap - outer corners rounded, inner corners square"/>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Border" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="Follows the pill shape chosen above - drawn around both pods fully if they're separate, or around just the outer sides (leaving the inner, facing sides open) if they're joined into one." Style="{DynamicResource Body}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="PillBorderEnabledCheck" Style="{DynamicResource SwitchToggle}" Content="Add a border line around the pills"/>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="BORDER COLOUR" Style="{DynamicResource Eyebrow}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PillBorderHexBox" Width="110" TextChanged="PillBorderHexBox_TextChanged"/>
                                    <Border x:Name="PillBorderColorPreview" Width="34" Height="34" CornerRadius="8" Margin="10,0,0,0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                </StackPanel>
                                <Grid Margin="0,16,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BORDER THICKNESS" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                    <Slider x:Name="PillBorderThicknessSlider" Grid.Column="1" Minimum="0.5" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6"/>
                                    <TextBlock x:Name="PillBorderThicknessValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Typeface" Style="{DynamicResource H2}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="FontCombo" Width="240" HorizontalAlignment="Left" Style="{StaticResource FontComboUpward}"/>
                            <Grid Margin="0,16,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SPEED FONT SIZE" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="8" Maximum="22" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock x:Name="FontSizeValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Layout">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="ScrollCachePanel3" Margin="0,0,14,10" CacheMode="BitmapCache">
                            <TextBlock Text="What the widget shows" Style="{DynamicResource H2}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ShowUpCheck" Style="{DynamicResource SwitchToggle}" Content="Upload row" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ShowDownCheck" Style="{DynamicResource SwitchToggle}" Content="Download row" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ShowTodayCheck" Style="{DynamicResource SwitchToggle}" Content="Total box" Margin="0,0,0,10"/>
                            <CheckBox x:Name="TodayMonthCheck" Style="{DynamicResource SwitchToggle}" Content="Total box counts the whole month instead of today" Margin="0,0,0,10"/>
                            <CheckBox x:Name="TotalBeforeCheck" Style="{DynamicResource SwitchToggle}" Content="Put the total box to the left of the speed box"/>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Speed box" Style="{DynamicResource H2}" Margin="0,0,0,10"/>
                            <Grid x:Name="SpeedSliderGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" x:Name="WidthSlider" Minimum="70" Maximum="400" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="WidthValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Height" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" x:Name="HeightSlider" Minimum="18" Maximum="120" Margin="0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HeightValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Horizontal padding" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" x:Name="PaddingHSlider" Minimum="0" Maximum="24" Margin="0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PaddingHValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vertical padding" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" x:Name="PaddingVSlider" Minimum="0" Maximum="24" Margin="0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="PaddingVValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Arrow to text gap" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="4" Grid.Column="1" x:Name="IconGapSlider" Minimum="0" Maximum="20" Margin="0,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="IconGapValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Row gap" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="5" Grid.Column="1" x:Name="RowGapSlider" Minimum="0" Maximum="16" Margin="0,6"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="RowGapValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Number to unit gap" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="6" Grid.Column="1" x:Name="DigitUnitGapSlider" Minimum="0" Maximum="16" Margin="0,6"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="DigitUnitGapValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="DigitsBoldCheck" Content="Bold numbers" Margin="0,0,24,0"/>
                                <CheckBox x:Name="UnitBoldCheck" Content="Bold units"/>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Total box" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="Fully independent from the speed box." Style="{DynamicResource Body}" Margin="0,0,0,14"/>
                            <TextBlock Text="LABEL" Style="{DynamicResource Eyebrow}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TodayLabelCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Font size" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" x:Name="TodayFontSizeSlider" Minimum="8" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TodayFontSizeValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Horizontal padding" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" x:Name="TodayPaddingHSlider" Minimum="0" Maximum="24" Margin="0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TodayPaddingHValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Vertical padding" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" x:Name="TodayPaddingVSlider" Minimum="0" Maximum="24" Margin="0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TodayPaddingVValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap between boxes" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" x:Name="GroupGapSlider" Minimum="0" Maximum="40" Margin="0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="GroupGapValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Number to unit gap" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="4" Grid.Column="1" x:Name="TodayDigitUnitGapSlider" Minimum="0" Maximum="16" Margin="0,6"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TodayDigitUnitGapValue" Style="{DynamicResource Mono}" FontSize="12" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="TodayDigitsBoldCheck" Content="Bold number" Margin="0,0,24,0"/>
                                <CheckBox x:Name="TodayUnitBoldCheck" Content="Bold unit"/>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Rotating content" Style="{DynamicResource H2}" Margin="0,0,0,6"/>
                            <TextBlock Text="Periodically swap a pill between its normal content, your IP address, and your location. Pick which pill each one appears on below - they can share a pill or use different ones. Whichever pill is showing rotated content resizes to fit it." Style="{DynamicResource Body}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RotatingPillEnabledCheck" Style="{DynamicResource SwitchToggle}" Content="Enable rotating content"/>
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox x:Name="RotateShowIpCheck" Content="Show IP address" VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="on" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="IpTargetPillCombo" Width="140">
                                        <ComboBoxItem Content="Today pill"/>
                                        <ComboBoxItem Content="Speed pill"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="RotateShowFlagCheck" Content="Show location (country)" VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="on" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="FlagTargetPillCombo" Width="140">
                                        <ComboBoxItem Content="Today pill"/>
                                        <ComboBoxItem Content="Speed pill"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Looks up your public IP and country from a third-party lookup service, refreshed every few minutes - not on every rotation." Style="{DynamicResource Body}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,16,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rotation interval" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                <Slider x:Name="RotatingIntervalSlider" Grid.Column="1" Minimum="5" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock x:Name="RotatingIntervalValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <CheckBox x:Name="EmbeddedFadeCheck" Content="Fade transition in embedded mode" Margin="0,10,0,0"/>
                            <TextBlock Text="Off by default - embedded mode's rendering is lower-level than the floating widget's, so try this and see how it feels on your machine before leaving it on." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Position" Style="{DynamicResource H2}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ManualPositionCheck" Style="{DynamicResource SwitchToggle}" Content="Place the widget manually instead of docking beside the tray"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="X" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="PosXBox" Width="80"/>
                                <TextBlock Text="Y" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <TextBox x:Name="PosYBox" Width="80"/>
                            </StackPanel>
                            <TextBlock Text="FINE ADJUSTMENT" Style="{DynamicResource Eyebrow}" Margin="0,18,0,4"/>
                            <TextBlock Text="A nudge applied on top of whichever positioning mode is active above." Style="{DynamicResource Body}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="X" Style="{DynamicResource Body}" VerticalAlignment="Center" Width="16"/>
                                <Button Content="&#x2212;" Style="{DynamicResource IconButton}" Click="OffsetXMinus_Click"/>
                                <TextBlock x:Name="OffsetXLabel" Text="0" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Width="46" TextAlignment="Center"/>
                                <Button Content="+" Style="{DynamicResource IconButton}" Click="OffsetXPlus_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Y" Style="{DynamicResource Body}" VerticalAlignment="Center" Width="16"/>
                                <Button Content="&#x2212;" Style="{DynamicResource IconButton}" Click="OffsetYMinus_Click"/>
                                <TextBlock x:Name="OffsetYLabel" Text="0" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Width="46" TextAlignment="Center"/>
                                <Button Content="+" Style="{DynamicResource IconButton}" Click="OffsetYPlus_Click"/>
                                <Button Content="Reset" Click="OffsetReset_Click" Margin="16,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="ResetCompactButton" Content="Reset to compact layout" Click="ResetCompact_Click" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Data &amp; units">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="ScrollCachePanel4" Margin="0,0,14,10" CacheMode="BitmapCache">
                            <TextBlock Text="Units" Style="{DynamicResource H2}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="BinaryUnitsCheck" Style="{DynamicResource SwitchToggle}" Content="Binary units - KiB / MiB / GiB, 1024-based"/>
                            <TextBlock Text="Off means decimal units: KB / MB / GB, 1000-based." Style="{DynamicResource Body}" Margin="0,4,0,10"/>
                            <CheckBox x:Name="BitsCheck" Style="{DynamicResource SwitchToggle}" Content="Show speed in bits per second (Mbps)"/>
                            <TextBlock Text="Bit rates are always decimal by convention." Style="{DynamicResource Body}" Margin="0,4,0,0"/>
                            <TextBlock Text="DECIMAL PLACES" Style="{DynamicResource Eyebrow}" Margin="0,18,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Decimals1" Content="One  (4.2)" GroupName="Decimals" Margin="0,0,28,0"/>
                                <RadioButton x:Name="Decimals2" Content="Two  (4.23)" GroupName="Decimals"/>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Usage alerts" Style="{DynamicResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="A tray notification the first time a cap is passed." Style="{DynamicResource Body}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Daily limit" Style="{DynamicResource Body}" VerticalAlignment="Center" Width="120"/>
                                <TextBox x:Name="DailyLimitBox" Width="100"/>
                                <TextBlock x:Name="DailyLimitUnit" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Monthly limit" Style="{DynamicResource Body}" VerticalAlignment="Center" Width="120"/>
                                <TextBox x:Name="MonthlyLimitBox" Width="100"/>
                                <TextBlock x:Name="MonthlyLimitUnit" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Dashboard chart" Style="{DynamicResource H2}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HISTORY WINDOW" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <Slider x:Name="ChartWindowSlider" Grid.Column="1" Minimum="30" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6"/>
                                <TextBlock x:Name="ChartWindowValue" Grid.Column="2" Style="{DynamicResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="About">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:SmoothScroll.Enabled="True">
                        <StackPanel x:Name="ScrollCachePanel5" Margin="0,0,14,10" CacheMode="BitmapCache">
                            <Border Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GeeTM" Style="{DynamicResource H1}"/>
                                    <TextBlock x:Name="VersionText" Style="{DynamicResource Body}" Margin="0,4,0,0"/>
                                    <TextBlock Text="A network traffic monitor for Windows, built by GeeDevv." Style="{DynamicResource Body}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Files" Style="{DynamicResource H2}" Margin="0,22,0,4"/>
                            <TextBlock x:Name="DataFolderText" Style="{DynamicResource Body}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open data folder" Click="OpenDataFolder_Click" Margin="0,0,10,0"/>
                                <Button Content="View log" Click="OpenLog_Click"/>
                            </StackPanel>
                            <Border Style="{DynamicResource Divider}"/>
                            <TextBlock Text="Reset" Style="{DynamicResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="Restores every setting to its default." Style="{DynamicResource Body}" Margin="0,0,0,12"/>
                            <Button Content="Reset all settings" Style="{DynamicResource DangerButton}" Click="ResetAll_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="20,14" Margin="0,18,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Style="{DynamicResource Body}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                        <Button Content="Apply" Click="Apply_Click" Margin="0,0,8,0"/>
                        <Button Content="Save" Click="Ok_Click" Style="{DynamicResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>



