<Window x:Class="GeeTM.Views.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:svc="clr-namespace:GeeTM.Services"
        Title="GeeTM Dashboard"
        Height="560" Width="960" MinWidth="720" MinHeight="440"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootShell" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="204"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION (collapsible, expanded by default) -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,18,0,16">

                    <!-- Brand + collapse toggle -->
                    <Grid DockPanel.Dock="Top" Margin="18,0,12,26">
                        <StackPanel x:Name="BrandRow" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="BrandText" Text="GeeTM" Style="{DynamicResource H2}"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="CollapseBtn" Style="{DynamicResource IconButton}" HorizontalAlignment="Right"
                                Click="ToggleSidebar_Click" ToolTip="Collapse sidebar"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>

                    <!-- Bottom-docked exit -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,0,0,10"/>
                        <Button x:Name="NavExit" Style="{DynamicResource NavButtonDanger}" Tag="&#xE7E8;"
                                Content="Exit GeeTM" Click="Exit_Click"/>
                    </StackPanel>

                    <!-- Primary nav -->
                    <StackPanel VerticalAlignment="Top" Margin="12,0">
                        <Button x:Name="NavDashboard" Style="{DynamicResource NavButton}" Tag="&#xE80F;"
                                Content="Dashboard" IsEnabled="False" Click="NavDashboard_Click"/>
                        <Button x:Name="NavHistory" Style="{DynamicResource NavButton}" Tag="&#xE81C;"
                                Content="Usage History" Click="NavHistory_Click"/>
                        <Button x:Name="NavDataCaps" Style="{DynamicResource NavButton}" Tag="&#xE72E;"
                                Content="Data Caps" Click="NavDataCaps_Click"/>
                        <Button x:Name="NavSettings" Style="{DynamicResource NavButton}" Tag="&#xE713;"
                                Content="Settings" Click="Settings_Click"/>
                        <Button x:Name="NavAdapter" Style="{DynamicResource NavButton}" Tag="&#xE839;"
                                Content="Choose Adapter" Click="Adapter_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TITLE BAR -->
                <Grid Grid.Row="0" Height="46">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="Dashboard" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#x2013;" Style="{DynamicResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimise"/>
                        <Button x:Name="MaxButton" Content="&#x25A1;" Style="{DynamicResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximise"/>
                        <Button Content="&#x2715;" Style="{DynamicResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- STAT CARDS -->
                <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="DashboardMainView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1" Margin="20,4,20,16">
                    <Border Style="{DynamicResource Card}" Margin="0,0,12,0" Padding="0">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource DownBrush}" CornerRadius="12,0,0,12"/>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="DOWNLOAD" Style="{DynamicResource Eyebrow}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="DownSpeedBig" Text="0.00" Style="{DynamicResource Mono}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource DownBrush}"/>
                                    <TextBlock x:Name="DownUnitBig" Text="KB/s" Style="{DynamicResource Mono}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="0,0,12,0" Padding="0">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource UpBrush}" CornerRadius="12,0,0,12"/>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="UPLOAD" Style="{DynamicResource Eyebrow}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="UpSpeedBig" Text="0.00" Style="{DynamicResource Mono}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource UpBrush}"/>
                                    <TextBlock x:Name="UpUnitBig" Text="KB/s" Style="{DynamicResource Mono}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{DynamicResource Card}" Margin="0,0,12,0" Padding="0">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="12,0,0,12"/>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="TODAY" Style="{DynamicResource Eyebrow}"/>
                                <TextBlock x:Name="TodayTotal" Text="0.0 MB" Style="{DynamicResource Mono}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TodayLimitHint" Style="{DynamicResource Eyebrow}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{DynamicResource Card}" Padding="0">
                        <Grid>
                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource BorderStrongBrush}" CornerRadius="12,0,0,12"/>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="THIS MONTH" Style="{DynamicResource Eyebrow}"/>
                                <TextBlock x:Name="MonthTotal" Text="0.0 MB" Style="{DynamicResource Mono}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="AdapterName" Text="&#x2014;" Style="{DynamicResource Eyebrow}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- CHART + PROCESSES -->
                <Grid Grid.Row="1" Margin="20,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*" MinWidth="250"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="14,12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="THROUGHPUT" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DownBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Down" Style="{DynamicResource Eyebrow}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource UpBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Up" Style="{DynamicResource Eyebrow}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <lvc:CartesianChart x:Name="SpeedChart"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="TOP PROCESSES" Style="{DynamicResource Eyebrow}" Margin="0,0,0,10"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PROCESS" Style="{DynamicResource Eyebrow}"/>
                                <TextBlock Grid.Column="1" Text="DOWN" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource DownBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="UP" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource UpBrush}" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="ProcessEmptyHint" DockPanel.Dock="Top" Style="{DynamicResource Body}" Margin="0,10,0,0" Visibility="Collapsed"
                                       Text="Per-process bandwidth needs GeeTM to be running as administrator. Enable it in Settings."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" svc:SmoothScroll.Enabled="True">
                                <ItemsControl x:Name="ProcessList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="78"/>
                                                        <ColumnDefinition Width="78"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DownDisplay}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UpDisplay}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
                </Grid>

                <!-- USAGE HISTORY VIEW -->
                <Grid x:Name="HistoryView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="20,4,20,20">
                    <Border Style="{DynamicResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="USAGE HISTORY" Style="{DynamicResource Eyebrow}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Last 30 days, by adapter. A LOCAL tag marks adapters that looked like a local or virtual connection (Docker, WSL, and similar) rather than a real internet connection - a best-effort read, not a guarantee." Style="{DynamicResource Body}" Margin="0,0,0,14"/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE" Style="{DynamicResource Eyebrow}"/>
                                <TextBlock Grid.Column="1" Text="ADAPTER" Style="{DynamicResource Eyebrow}"/>
                                <TextBlock Grid.Column="2" Text="DOWN" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource DownBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="UP" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource UpBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="HistoryEmptyHint" DockPanel.Dock="Top" Style="{DynamicResource Body}" Margin="0,10,0,0" Visibility="Collapsed"
                                       Text="No history yet - check back after GeeTM has been running for a little while."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" svc:SmoothScroll.Enabled="True">
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DateDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{DynamicResource UiFont}" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AdapterName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding LocalTagVisibility}">
                                                            <TextBlock Text="LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DownDisplay}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding UpDisplay}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- DATA CAPS VIEW -->
                <Grid x:Name="DataCapsView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="20,4,20,20">
                    <Border Style="{DynamicResource Card}" Padding="14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DATA CAPS" Style="{DynamicResource Eyebrow}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Set a daily limit for a specific app and get notified once it's reached. Matched by process name, so it applies across restarts of that app." Style="{DynamicResource Body}" Margin="0,0,0,14"/>

                            <!-- ADD A CAP -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Process name" Style="{DynamicResource Body}" Width="180" VerticalAlignment="Center"/>
                                    <TextBlock Text="Daily limit" Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CapProcessNameBox" Grid.Column="0" Margin="0,0,8,0"/>
                                    <TextBox x:Name="CapAmountBox" Grid.Column="1" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CapUnitCombo" Grid.Column="2" Margin="0,0,8,0" SelectedIndex="1">
                                        <ComboBoxItem Content="MB"/>
                                        <ComboBoxItem Content="GB"/>
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="Add cap" Style="{DynamicResource PrimaryButton}" Click="AddCap_Click"/>
                                </Grid>
                                <TextBlock Text="Enter the process name without .exe (e.g. chrome, not chrome.exe)." Style="{DynamicResource Body}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CapErrorHint" DockPanel.Dock="Top" Style="{DynamicResource Body}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10" Visibility="Collapsed"/>

                            <TextBlock x:Name="CapsEmptyHint" DockPanel.Dock="Top" Style="{DynamicResource Body}" Margin="0,4,0,0" Visibility="Collapsed"
                                       Text="No caps set yet - add one above to get a notification when an app crosses its daily limit."/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" svc:SmoothScroll.Enabled="True">
                                <ItemsControl x:Name="CapsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding UsageDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <Button Grid.Column="2" Content="Remove" Style="{DynamicResource GhostButton}" FontSize="11" Padding="8,4" Tag="{Binding ProcessName}" Click="RemoveCap_Click"/>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                                                 Foreground="{Binding ProgressColor}" Background="{DynamicResource ElevatedBrush}"
                                                                 BorderThickness="0" Margin="0,8,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>



