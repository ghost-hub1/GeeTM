<Window x:Class="GeeTM.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeeTM"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- Deliberately empty. The widget's visuals live in WidgetSurface so the
         exact same control can be hosted either here (floating layered window)
         or inside a child HwndSource embedded in the taskbar. The controller
         assigns SurfaceHost.Content only in floating mode. -->
    <ContentControl x:Name="SurfaceHost"/>
</Window>



