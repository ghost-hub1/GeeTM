<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mono skin.
         No hue at all except for the two direction colours. The most restrained option and the one that disappears most completely into a default Windows taskbar.

         Themes carry colour and type only. Every control template lives in
         Controls.xaml and resolves these keys through DynamicResource, so
         switching skins restyles the whole app live and no two skins can drift
         apart structurally. Any new skin only has to define this same key set. -->

    <!-- Raw colours are exported alongside the brushes because the dashboard
         chart is drawn by SkiaSharp, which needs colour components rather than
         a WPF brush. -->
    <Color x:Key="BgColor">#0D0D0D</Color>
    <Color x:Key="SurfaceColor">#151515</Color>
    <Color x:Key="AccentColor">#E5E5E5</Color>
    <Color x:Key="UpColor">#D4D4D4</Color>
    <Color x:Key="DownColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F5</Color>
    <Color x:Key="TextMutedColor">#7C7C7C</Color>
    <Color x:Key="BorderColor">#2A2A2A</Color>

    <!-- Base surfaces, lightest-on-top ordering: Bg &lt; Surface &lt; SurfaceAlt &lt; Elevated -->
    <SolidColorBrush x:Key="BgBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#151515"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#212121"/>

    <!-- Hairlines. BorderStrong is the hover/active state of Border. -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3A3A"/>

    <!-- Interaction states -->
    <SolidColorBrush x:Key="HoverBrush" Color="#232323"/>
    <SolidColorBrush x:Key="PressBrush" Color="#181818"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2B2B2B"/>

    <!-- Accent. OnAccentText is the contrast-safe foreground for anything
         sitting on top of a filled accent surface. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#0D0D0D"/>

    <!-- Direction colours: the only semantic hues in the palette, so speed
         reads instantly without a legend. -->
    <SolidColorBrush x:Key="UpBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="DownBrush" Color="#FFFFFF"/>

    <!-- Text ramp: Primary for values, Secondary for prose, Muted for labels. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C7C7C"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#EF6B6B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#8BD98B"/>

    <!-- Segoe UI Variable is Windows 11's UI face and falls back cleanly to
         Segoe UI on Windows 10. Cascadia Mono keeps digits the same width so
         a changing speed reading never shifts the layout. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>



