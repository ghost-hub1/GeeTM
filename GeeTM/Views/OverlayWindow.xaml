<Window x:Class="GeeTM.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeeTM Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">

    <!-- Deliberately minimal: no theming system, no settings-driven layout -
         this is a small always-on-top HUD shown only while something else is
         fullscreen, not another surface for the main widget's appearance
         system. Kept visually similar (rounded pods, colored arrows) so it
         reads as clearly the same app, without depending on any of the main
         widget's rendering code. -->
    <Border Background="#CC0E1116" CornerRadius="8" Padding="10,7">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="&#x2191;" Foreground="#FB923C" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpText" Text="0.00 KB/s" Foreground="White" FontSize="13" FontWeight="Bold"
                           FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x2193;" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="DownText" Text="0.00 KB/s" Foreground="White" FontSize="13" FontWeight="Bold"
                           FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
